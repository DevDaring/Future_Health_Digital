# WASL configuration. Copy to .env — everything works with ZERO API keys (mock LLM).
# Database (docker-compose service "db"; for local runs use 127.0.0.1)
DATABASE_URL=postgresql+psycopg://wasl:wasl@db:5432/wasl
JWT_SECRET=change-me                 # sign JWTs; set a long random value in production
DEMO_MODE=true                       # enables /api/demo/* (reset, simulated clock, tamper demo)
SEED=42                              # every random process is seeded → identical demo data
POPULATION_SIZE=5000
DAILY_OUTREACH_BUDGET=200
PUBLIC_URL=http://localhost:5173     # used to build patient magic links
CORS_ORIGINS=http://localhost:5173

# LLM: mock (default, offline) | anthropic | nanogpt | linkapi | relay (LinkAPI fast + NanoGPT quality) | azure_openai
LLM_PROVIDER=mock
LLM_MODEL=claude-opus-5-5            # used when LLM_PROVIDER=anthropic (claude-sonnet-5-5 / claude-haiku-5-5 are cheaper)
ANTHROPIC_API_KEY=
NANOGPT_API_KEY=                     # OpenAI-compatible relay, e.g. model anthropic/claude-haiku-5.5
NANOGPT_BASE_URL=https://nano-gpt.com/api/v1
NANOGPT_MODEL=anthropic/claude-haiku-5.5
LINKAPI_API_KEY=                     # OpenAI-compatible relay, fast model for chat understanding + QA judge
LINKAPI_BASE_URL=https://api.linkapi.ai/v1
LINKAPI_MODEL=gemini-3-flash-preview
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

TRANSLATION_PASS_THRESHOLD=0.85      # judge score needed (plus exact entity match) to send a translation
SLA_DAYS_URGENT=7                    # ILLUSTRATIVE
SLA_DAYS_HIGH=21                     # ILLUSTRATIVE
SLA_DAYS_ROUTINE=60                  # ILLUSTRATIVE

VITE_API_URL=                        # empty = same origin (/api); dev server proxies to :8000
