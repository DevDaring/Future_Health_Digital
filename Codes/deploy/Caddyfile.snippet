# >>> wasl
# WASL (Future Health Challenge) - https://wasl.koushikdeb.com : static React build + /api -> FastAPI on 127.0.0.1:8200
# DNS: NameSilo A record "wasl" -> 154.12.116.152. TLS via Caddy ACME. Deploy: Codes/deploy/deploy.sh
wasl.koushikdeb.com {
	encode zstd gzip
	log {
		output file /var/log/caddy/wasl.log {
			roll_size 50MiB
			roll_keep 5
			roll_keep_for 2160h
		}
		format json
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Microphone: optional voice input in the patient chat (first-party only).
		Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@html path / /index.html
	header @html Cache-Control "no-cache"
	handle /api/* {
		request_body {
			max_size 5MB
		}
		reverse_proxy 127.0.0.1:8200 {
			header_up X-Real-IP {remote_host}
			transport http {
				read_timeout 180s
				# idle upstream connections close before uvicorn's 120 s keep-alive: no reset races (502)
				keepalive 60s
			}
		}
	}
	handle {
		root * /home/Debz/Host/wasl/web
		try_files {path} /index.html
		file_server
	}
}
# <<< wasl
